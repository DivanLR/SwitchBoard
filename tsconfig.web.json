{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/*"]
    },
    "outDir": "out/tsc-web"
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.vue", "src/shared/**/*.ts", "tests/e2e/**/*.ts", "tests/unit/renderer/**/*.ts"],
  // The real-application harness imports main-process code to seed the real
  // database schema, which this project must not see. It has its own project:
  // tsconfig.realapp.json.
  "exclude": ["tests/e2e/real-app.spec.ts", "tests/e2e/seed-real-app.ts"]
}
