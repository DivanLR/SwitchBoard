{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    // ES2024 for Object.groupBy, which replaced two hand-rolled group-by loops.
    // The renderer only ever runs in this app's own Chromium, which has shipped it
    // since 117, so the lib is describing the real runtime rather than widening it.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/*"]
    },
    "outDir": "out/tsc-web"
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.vue", "src/shared/**/*.ts", "tests/e2e/**/*.ts", "tests/unit/renderer/**/*.ts"],
  // The real-application harness imports main-process code to seed the real
  // database schema, which this project must not see. It has its own project:
  // tsconfig.realapp.json.
  "exclude": ["tests/e2e/real-app.spec.ts", "tests/e2e/seed-real-app.ts"]
}
