# --- Dependencies ---
node_modules/

# --- Build output and generated artifacts (temporary) ---
out/
dist/
.vite/
*.tsbuildinfo

# --- Packaged executables / releases (published to GitHub manually) ---
release/
# Belt-and-suspenders: never commit build artifacts even if they land elsewhere.
# Only the installer is attached to a GitHub release; nothing goes in git.
*.exe
*.blockmap
latest*.yml
*.nupkg

# --- Secrets / signing material (never commit) ---
*.pem
*.key
*.p12
*.pfx
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Test and coverage artifacts (temporary) ---
coverage/
test-results/
playwright-report/

# --- Logs and environment ---
*.log
.env
.env.*

# --- OS and editor cruft ---
.DS_Store
Thumbs.db
*.tmp
*.swp
.vscode/
.idea/

# --- AI assistant tooling, plugins, and instruction files (not the base project) ---
# specs/ and .specify/ are anchored to the repo root: they ignore spec-kit's own
# output when it is run against THIS repo, without matching src/main/specs/ (the
# app's source). A bare `specs/` matches at any depth and hid spec-kit.ts.
.claude/
/.specify/
/specs/
CLAUDE.md
AGENTS.md
.cursorrules
.ponytail
.ponytail/

# Impeccable session state: decision-page payloads and the live-mode journal are
# per-session scratch, not source. The design sidecar and live config ARE tracked.
.impeccable/questions/
.impeccable/live/sessions/
.impeccable/sketches/
