{
  "name": "terminal-switchboard",
  "version": "0.23.0",
  "description": "Switchboard: one desktop window hosting every Claude Code session, with a central permission inbox, clean output views, and per-project context.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.config.ts",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --win",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:e2e",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:realapp",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:realapp": "tsc --noEmit -p tsconfig.realapp.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:real": "npm run build && playwright test --config playwright.real.config.ts",
    "prune": "tsx src/main/store/prune-cli.ts",
    "verify-release": "tsx scripts/verify-release.ts",
    "design": "node design-lab/server.mjs"
  },
  "author": "Haefele Software",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.215",
    "electron-updater": "^6.8.9",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
